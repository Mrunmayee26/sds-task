# Database Connection (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Database Connection Pool
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=10

# Redis: required for auth throttling and five-minute drafting notices
REDIS_URL=redis://localhost:6379/0
# On the deployed backend, set this to the public frontend URL (no query/hash).
# Recovery emails link here; localhost works only during local development.
FRONTEND_URL=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=coep.ac.in

# Campus booking policy (IST); 0-24 means all-day availability
CANCELLATION_HOURS=8
MAX_BOOKING_HOURS=12
ADVANCE_BOOKING_DAYS=180
OPENING_HOUR=0
CLOSING_HOUR=24
APPROVAL_REMINDER_HOURS=24

# Security & JWT Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP Email Service
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Port 587 uses STARTTLS; port 465 uses implicit TLS automatically.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@coep.ac.in
SMTP_FROM_NAME="COEP VenueFlow"
SMTP_USE_TLS=true
